        "z": "874e520deb46e664",
        "name": "function 1",
        "func": "// ตรวจสอบก่อนว่ามีข้อมูลส่งมาจาก Modbus จริงไหม\nif (msg.payload && msg.payload.data) {\n    msg.payload = {\n        \"temp\": msg.payload.data[0], // ดึงค่าจากอาเรย์ data ช่องที่ 0\n        \"pump\": msg.payload.data[1]  // ดึงค่าจากอาเรย์ data ช่องที่ 1\n    };\n} else {\n    // กรณีข้อมูลไม่มา ให้คงค่าเดิมไว้หรือส่ง null\n    msg.payload = { \"temp\": 0, \"pump\": 0 };\n}\nreturn msg;",
